# 仅变量名称与占位值。真实值放本机 .env，禁止提交。
# 复制为 .env 后按需填写；未填写的项对应能力标记为 unavailable，不得伪造。

# 数据库。D1 用 SQLite 便于零依赖跑通；交付阶段切 PostgreSQL。
# 注意：种子脚本只会写入路径含 "synthetic" 的数据库。
DATABASE_URL=sqlite:///data/synthetic/business.db

# 模型（D2 已接入）。留空时工具层仍可独立测试，但 ModelClient 会显式抛
# ModelUnavailableError，不返回编造结果（见 docs/decisions.md D-008）。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# 模型单价（元 / 百万 token）。**留空 = 单价未核对**：此时只记录真实 token，
# 不折算金额、不计入预算消耗，避免用别家模型的价格冒充本模型。
PRICE_PER_1M_INPUT_CNY=
PRICE_PER_1M_OUTPUT_CNY=

# 费用上限（单位：元）。达到上限即停止自动调用。
BUDGET_CONNECTIVITY_CNY=30
BUDGET_TOTAL_CNY=200
